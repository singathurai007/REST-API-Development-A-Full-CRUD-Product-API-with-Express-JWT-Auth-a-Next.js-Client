# Copy this file to `.env` and adjust as needed.

# Port the API listens on
PORT=4000

# development | production
NODE_ENV=development

# Secret used to sign JWTs. ALWAYS change this outside of local development.
JWT_SECRET=change-me-in-production

# How long an access token stays valid (vercel/ms format)
JWT_EXPIRES_IN=1h

# Secret used to sign *refresh* tokens. Keep it different from JWT_SECRET so an
# access token can never be replayed as a refresh token.
JWT_REFRESH_SECRET=change-me-too-in-production

# How long a refresh token stays valid before the user must log in again
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed by CORS
CLIENT_ORIGIN=http://localhost:3000

# Rate limit: max requests per window, per IP
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
